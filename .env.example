# =============================================================================
# Django
# =============================================================================
DEBUG=True
SECRET_KEY=change-me-in-production-this-is-a-local-dev-key-only
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgres://dristi:secret@localhost:5432/dristi

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# =============================================================================
# Dramatiq
# =============================================================================
DRAMATIQ_BROKER_URL=redis://localhost:6379/2

# =============================================================================
# Email (console backend in dev)
# =============================================================================
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=dev@example.com

# =============================================================================
# Messaging
# Leave MESSAGING_BACKENDS to be configured in code (import paths).
# =============================================================================
MESSAGING_TEMPLATE_ENGINE=jinja2
MESSAGING_DUMMY_SMS_ENDPOINT=
MESSAGING_DUMMY_SMS_TIMEOUT=30
MESSAGING_EMAIL_BACKEND=django
MESSAGING_EMAIL_HOST=
MESSAGING_EMAIL_PORT=587
MESSAGING_EMAIL_HOST_USER=
MESSAGING_EMAIL_HOST_PASSWORD=
MESSAGING_EMAIL_USE_TLS=True
MESSAGING_EMAIL_USE_SSL=False
MESSAGING_EMAIL_DEFAULT_FROM=
MESSAGING_EMAIL_TIMEOUT=30
MESSAGING_RETRY_DELAY_BASE=60
MESSAGING_RETRY_DELAY_MAX=3600

# =============================================================================
# S3-compatible media storage (rustfs / MinIO)
# Leave any value blank to fall back to local filesystem storage.
# =============================================================================
S3_API_ENDPOINT=http://localhost:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
