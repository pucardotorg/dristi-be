# =============================================================================
# Django
# =============================================================================
DEBUG=True
SECRET_KEY=change-me-in-production-this-is-a-local-dev-key-only
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 3000 is a common frontend dev-server port; change/add origins for your actual FE port (e.g. 5173/4200/8080).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=db
POSTGRES_DB=dristi
POSTGRES_USER=dristi
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CACHE_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1

# =============================================================================
# Dramatiq
# =============================================================================
DRAMATIQ_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/2

# =============================================================================
# Email (console backend in dev)
# =============================================================================
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=dev@example.com

# =============================================================================
# Messaging
# Leave MESSAGING_BACKENDS to be configured in code (import paths).
# =============================================================================
MESSAGING_TEMPLATE_ENGINE=jinja2
MESSAGING_DUMMY_SMS_ENDPOINT=
MESSAGING_DUMMY_SMS_TIMEOUT=30
MESSAGING_EMAIL_BACKEND=smtp
MESSAGING_EMAIL_HOST=mailhog
MESSAGING_EMAIL_PORT=1025
MESSAGING_EMAIL_HOST_USER=
MESSAGING_EMAIL_HOST_PASSWORD=
MESSAGING_EMAIL_USE_TLS=False
MESSAGING_EMAIL_USE_SSL=False
MESSAGING_EMAIL_DEFAULT_FROM=dev@example.com
MESSAGING_EMAIL_TIMEOUT=30
MESSAGING_RETRY_DELAY_BASE=60
MESSAGING_RETRY_DELAY_MAX=3600

# =============================================================================
# S3-compatible media storage (rustfs)
# Leave any value blank to fall back to local filesystem storage.
# These credentials are what the rustfs service itself starts with, so the
# server and its clients cannot drift apart. The hostname is the compose
# service name; use http://localhost:9000 to reach rustfs from the host.
#
# S3_PUBLIC_ENDPOINT is the endpoint that signed URLs name. It exists because
# S3_API_ENDPOINT is only resolvable inside the compose network, and a signed
# URL's host cannot be changed afterwards: SigV4 signs it. Leave it blank where
# clients can already reach S3_API_ENDPOINT.
# =============================================================================
S3_API_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123

# =============================================================================
# RustFS
# =============================================================================
RUSTFS_OBS_LOGGER_LEVEL=error
