# =============================================================================
# Django
# =============================================================================
DEBUG=True
SECRET_KEY=change-me-in-production-this-is-a-local-dev-key-only
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 3000 is a common frontend dev-server port; change/add origins for your actual FE port (e.g. 5173/4200/8080).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=db
POSTGRES_DB=dristi
POSTGRES_USER=dristi
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432
DATABASE_URL=postgres://dristi:secret@db:5432/dristi

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_ENABLED=True
CACHE_KEY_PREFIX=dristi-dev
CACHALOT_ENABLED=True
CACHALOT_TIMEOUT=120

# =============================================================================
# Dramatiq
# =============================================================================
DRAMATIQ_BROKER_URL=redis://redis:6379/2

# =============================================================================
# Email (console backend in dev)
# =============================================================================
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=dev@example.com

# =============================================================================
# Messaging
# Leave MESSAGING_BACKENDS to be configured in code (import paths).
# =============================================================================
MESSAGING_TEMPLATE_ENGINE=jinja2
MESSAGING_DUMMY_SMS_ENDPOINT=http://httpbin:8080/post
MESSAGING_DUMMY_SMS_TIMEOUT=30
MESSAGING_EMAIL_BACKEND=smtp
MESSAGING_EMAIL_HOST=mailhog
MESSAGING_EMAIL_PORT=1025
MESSAGING_EMAIL_HOST_USER=
MESSAGING_EMAIL_HOST_PASSWORD=
MESSAGING_EMAIL_USE_TLS=False
MESSAGING_EMAIL_USE_SSL=False
MESSAGING_EMAIL_DEFAULT_FROM=dev@example.com
MESSAGING_EMAIL_TIMEOUT=30
MESSAGING_RETRY_DELAY_BASE=60
MESSAGING_RETRY_DELAY_MAX=3600
MESSAGING_TASK_TIME_LIMIT=600000

# =============================================================================
# CDAC SMS gateway addon (addon.cdac_sms_gateway)
# Local development uses DummySMSBackend, so these may stay blank.
# =============================================================================
CDAC_SMS_URL=https://msdgweb.mgov.gov.in/esms/sendsmsrequestDLT
CDAC_SMS_USERNAME=
CDAC_SMS_PASSWORD=
CDAC_SMS_SENDER_ID=
CDAC_SMS_SECURE_KEY=
CDAC_SMS_TEMPLATE_ID=
CDAC_SMS_MOBILE_PREFIX=91
CDAC_SMS_ENABLED=True
CDAC_SMS_TIMEOUT=30
CDAC_SMS_VERIFY_SSL=True
CDAC_SMS_SUCCESS_CODES=200,201,202
CDAC_SMS_ERROR_CODES=
CDAC_SMS_VERIFY_RESPONSE=False
CDAC_SMS_VERIFY_RESPONSE_CONTAINS=
CDAC_SMS_PRINT_RESPONSE=True
CDAC_SMS_WHITELIST_NUMBERS=
CDAC_SMS_BLACKLIST_NUMBERS=
CDAC_SMS_USE_DEFAULT_NUMBER=False
CDAC_SMS_DEFAULT_NUMBER=

# =============================================================================
# S3-compatible media storage (rustfs)
# Leave any value blank to fall back to local filesystem storage.
# These credentials are what the rustfs service itself starts with, so the
# server and its clients cannot drift apart. The hostname is the compose
# service name; use http://localhost:9000 to reach rustfs from the host.
# =============================================================================
S3_API_ENDPOINT=http://rustfs:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123

# =============================================================================
# File storage module (apps.files)
# FILE_MAX_READ_BYTES caps what get_file_content() will open into memory. Keep
# it at or above FILE_MAX_SIZE_BYTES, or files this service accepted become
# unreadable. Leave it blank to follow FILE_MAX_SIZE_BYTES.
# =============================================================================
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_COUNT_PER_UPLOAD=10
FILE_MAX_READ_BYTES=10485760

# =============================================================================
# RustFS
# =============================================================================
RUSTFS_OBS_LOGGER_LEVEL=error

# =============================================================================
# eSign (spec 0015)
# The provider is a dotted path: the mock provider needs no C-DAC credentials
# and is the default locally and in CI.
# =============================================================================
ESIGN_PROVIDER=apps.esign.providers.mock.MockESignProvider
ESIGN_ENABLED=True
ESIGN_TRANSACTION_TTL=900
ESIGN_CALLBACK_GRACE_PERIOD=300
ESIGN_SIGNING_STUCK_TIMEOUT=300
ESIGN_MAX_ATTEMPTS=3
ESIGN_PLACEHOLDER_RETENTION=7
ESIGN_UI_REDIRECT_URL=http://localhost:3000/esign/return
ESIGN_CALLBACK_THROTTLE_RATE=60/min
ESIGN_CALLBACK_MAX_BODY_BYTES=262144
ESIGN_SYSTEM_ACTOR_ID=system

# =============================================================================
# CDAC eSign addon (spec 0015)
# Leave blank while the mock provider is selected. Set ESIGN_PROVIDER to
# addon.cdac_esign.provider.CDACESignProvider to activate the integration; the
# system checks then require every value below.
# =============================================================================
CDAC_ESIGN_URL=
CDAC_ESIGN_ASP_ID=
CDAC_ESIGN_RESPONSE_URL=
CDAC_ESIGN_KEYSTORE_PATH=
CDAC_ESIGN_KEYSTORE_PASSWORD=
CDAC_ESIGN_RESPONSE_CERT=
CDAC_ESIGN_VERSION=2.1
CDAC_ESIGN_AUTH_MODE=1
CDAC_ESIGN_HASH_ALGORITHM=SHA256
CDAC_ESIGN_EKYC_ID_TYPE=A
CDAC_ESIGN_CONSENT=Y
CDAC_ESIGN_TXN_TEMPLATE={module}-{transaction_id}
CDAC_ESIGN_RESPONSE_MAX_SKEW=900
CDAC_ESIGN_VERIFY_RESPONSE_SIGNATURE=True
CDAC_ESIGN_RESPONSE_FIELD=

# =============================================================================
# PDF service signing primitives (spec 0016), consumed by the eSign module
# =============================================================================
PDF_SIGNATURE_HASH_ALGORITHM=SHA256
PDF_SIGNATURE_CONTAINER_BYTES=16384
PDF_MAX_SIGN_INPUT_BYTES=20971520
