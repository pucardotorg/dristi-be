# =============================================================================
# CI-only environment for `manage.py check --deploy` (production settings).
# Dummy, non-secret values: nothing here is ever used to reach a real service.
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=github-actions-ci-secret-key-not-for-production-only-for-checks-0123456789
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
SECURE_SSL_REDIRECT=False

# S3-compatible media storage
S3_API_ENDPOINT=http://rustfs:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# CDAC SMS gateway addon (must be an absolute https:// URL)
CDAC_SMS_URL=https://httpbin.org/post
CDAC_SMS_USERNAME=ci-username
CDAC_SMS_PASSWORD=ci-password
CDAC_SMS_SENDER_ID=CISNDR
CDAC_SMS_SECURE_KEY=ci-secure-key

# CDAC eSign addon
# CDAC_ESIGN_KEYSTORE_PATH is set by the CI deploy-check step, which generates
# a throwaway keystore with this password for each run.
ESIGN_PROVIDER=addon.cdac_esign.provider.CDACESignProvider
CDAC_ESIGN_URL=https://httpbin.org/post
CDAC_ESIGN_ASP_ID=ci-asp-id
CDAC_ESIGN_KEYSTORE_PASSWORD=ci-keystore-password
# Production only checks that this is set; it is never used to verify anything in CI.
CDAC_ESIGN_RESPONSE_CERT=ci-dummy-response-certificate
CDAC_ESIGN_RESPONSE_URL=https://httpbin.org/post
ESIGN_UI_REDIRECT_URL=https://test.example.com/esign/return
