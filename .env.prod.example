# =============================================================================
# Django
# =============================================================================
DEBUG=False
SECRET_KEY=<generate-a-strong-secret-key-and-paste-here>
ALLOWED_HOSTS=api.example.com
DJANGO_SETTINGS_MODULE=config.settings.production

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgres://dristi:secure-password@postgres:5432/dristi

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CACHE_ENABLED=True
CACHE_KEY_PREFIX=dristi-prod
CACHALOT_ENABLED=True
CACHALOT_TIMEOUT=120

# =============================================================================
# Dramatiq
# =============================================================================
DRAMATIQ_BROKER_URL=redis://redis:6379/2

# =============================================================================
# Email
# =============================================================================
EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# Messaging
# Set MESSAGING_BACKENDS in code to your backend import paths.
# =============================================================================
MESSAGING_TEMPLATE_ENGINE=jinja2
MESSAGING_DUMMY_SMS_ENDPOINT=
MESSAGING_DUMMY_SMS_TIMEOUT=30
MESSAGING_EMAIL_BACKEND=smtp
MESSAGING_EMAIL_HOST=smtp.example.com
MESSAGING_EMAIL_PORT=587
MESSAGING_EMAIL_HOST_USER=notifications@example.com
MESSAGING_EMAIL_HOST_PASSWORD=
MESSAGING_EMAIL_USE_TLS=True
MESSAGING_EMAIL_USE_SSL=False
MESSAGING_EMAIL_DEFAULT_FROM=Dristi <notifications@example.com>
MESSAGING_EMAIL_TIMEOUT=30
MESSAGING_RETRY_DELAY_BASE=60
MESSAGING_RETRY_DELAY_MAX=3600

# =============================================================================
# S3-compatible media storage (rustfs)
# Leave any value blank to fall back to local filesystem storage.
# =============================================================================
S3_API_ENDPOINT=http://rustfs:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>

# =============================================================================
# Security
# =============================================================================
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# =============================================================================
# eSign (spec 0015)
# The mock provider and disabled response verification are refused in
# production; ESIGN_UI_REDIRECT_URL must be an absolute https:// URL.
# =============================================================================
ESIGN_PROVIDER=addon.cdac_esign.provider.CDACESignProvider
ESIGN_ENABLED=True
ESIGN_TRANSACTION_TTL=900
ESIGN_CALLBACK_GRACE_PERIOD=300
ESIGN_SIGNING_STUCK_TIMEOUT=300
ESIGN_MAX_ATTEMPTS=3
ESIGN_PLACEHOLDER_RETENTION=7
ESIGN_UI_REDIRECT_URL=https://app.example.com/esign/return
ESIGN_CALLBACK_THROTTLE_RATE=60/min

# =============================================================================
# CDAC eSign addon (spec 0015)
# The keystore is mounted by the deployment; the password comes from the
# secrets manager and is never logged or persisted.
# =============================================================================
CDAC_ESIGN_URL=https://esign.cdac.gov.in/...
CDAC_ESIGN_ASP_ID=<asp-id>
CDAC_ESIGN_RESPONSE_URL=https://api.example.com/api/v1/esign/_signed
CDAC_ESIGN_KEYSTORE_PATH=/run/secrets/asp-keystore.p12
CDAC_ESIGN_KEYSTORE_PASSWORD=<keystore-password>
CDAC_ESIGN_RESPONSE_CERT=<cdac-response-certificate-pem>
CDAC_ESIGN_VERIFY_RESPONSE_SIGNATURE=True

# =============================================================================
# PDF service signing primitives (spec 0016)
# =============================================================================
PDF_SIGNATURE_HASH_ALGORITHM=SHA256
PDF_SIGNATURE_CONTAINER_BYTES=16384
PDF_MAX_SIGN_INPUT_BYTES=20971520
