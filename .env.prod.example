# =============================================================================
# Django
# =============================================================================
DEBUG=False
SECRET_KEY=<generate-a-strong-secret-key-and-paste-here>
ALLOWED_HOSTS=api.example.com
DJANGO_SETTINGS_MODULE=config.settings.production

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgres://dristi:secure-password@postgres:5432/dristi

# =============================================================================
# Cache & Queue (Redis)
# =============================================================================
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CACHE_ENABLED=True
CACHE_KEY_PREFIX=dristi-prod
CACHALOT_ENABLED=True
CACHALOT_TIMEOUT=120

# =============================================================================
# Business rules (spec 0019)
# =============================================================================
RULES_EVALUATION_TIMEOUT_SECONDS=2
RULES_MAX_EXPRESSION_BYTES=262144
RULES_ADMIN_DRY_RUN_REQUIRED=True

# =============================================================================
# Dramatiq
# =============================================================================
DRAMATIQ_BROKER_URL=redis://redis:6379/2

# =============================================================================
# Email
# =============================================================================
EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# Messaging
# Set MESSAGING_BACKENDS in code to your backend import paths.
# =============================================================================
MESSAGING_TEMPLATE_ENGINE=jinja2
MESSAGING_DUMMY_SMS_ENDPOINT=
MESSAGING_DUMMY_SMS_TIMEOUT=30
MESSAGING_EMAIL_BACKEND=smtp
MESSAGING_EMAIL_HOST=smtp.example.com
MESSAGING_EMAIL_PORT=587
MESSAGING_EMAIL_HOST_USER=notifications@example.com
MESSAGING_EMAIL_HOST_PASSWORD=
MESSAGING_EMAIL_USE_TLS=True
MESSAGING_EMAIL_USE_SSL=False
MESSAGING_EMAIL_DEFAULT_FROM=Dristi <notifications@example.com>
MESSAGING_EMAIL_TIMEOUT=30
MESSAGING_RETRY_DELAY_BASE=60
MESSAGING_RETRY_DELAY_MAX=3600
MESSAGING_TASK_TIME_LIMIT=600000

# =============================================================================
# CDAC SMS gateway addon (addon.cdac_sms_gateway)
# Required whenever MESSAGING_BACKENDS["sms"] is CDACSMSBackend.
# CDAC_SMS_USE_DEFAULT_NUMBER and CDAC_SMS_VERIFY_SSL=False are rejected here.
# =============================================================================
CDAC_SMS_URL=https://msdgweb.mgov.gov.in/esms/sendsmsrequestDLT
CDAC_SMS_USERNAME=
CDAC_SMS_PASSWORD=
CDAC_SMS_SENDER_ID=
CDAC_SMS_SECURE_KEY=
CDAC_SMS_TEMPLATE_ID=
CDAC_SMS_MOBILE_PREFIX=91
CDAC_SMS_ENABLED=True
CDAC_SMS_TIMEOUT=30
CDAC_SMS_VERIFY_SSL=True
CDAC_SMS_SUCCESS_CODES=200,201,202
CDAC_SMS_ERROR_CODES=
CDAC_SMS_VERIFY_RESPONSE=True
CDAC_SMS_VERIFY_RESPONSE_CONTAINS=MsgID
CDAC_SMS_PRINT_RESPONSE=True
CDAC_SMS_WHITELIST_NUMBERS=
CDAC_SMS_BLACKLIST_NUMBERS=
CDAC_SMS_USE_DEFAULT_NUMBER=False
CDAC_SMS_DEFAULT_NUMBER=

# =============================================================================
# S3-compatible media storage (rustfs)
# Leave any value blank to fall back to local filesystem storage.
# =============================================================================
S3_API_ENDPOINT=http://rustfs:9000
S3_BUCKET=dristi-media
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>

# =============================================================================
# File storage module (apps.files)
# FILE_MAX_READ_BYTES caps what get_file_content() will open into memory. Keep
# it at or above FILE_MAX_SIZE_BYTES, or files this service accepted become
# unreadable. Leave it blank to follow FILE_MAX_SIZE_BYTES.
# =============================================================================
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_COUNT_PER_UPLOAD=10
FILE_MAX_READ_BYTES=10485760

# =============================================================================
# Security
# =============================================================================
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
